{
  "name": "openclaw-nano-x402-guard",
  "version": "0.1.0",
  "description": "An opt-in OpenClaw tool for capped, allowlisted Nano x402 exact purchases",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./index.mjs",
    "./guard": "./guarded-purchase.mjs",
    "./client": "./nano-client.mjs",
    "./manual-nault": "./manual-nault-helper.mjs"
  },
  "files": [
    "index.mjs",
    "guarded-purchase.mjs",
    "nano-client.mjs",
    "env-helper.mjs",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "manual-nault-helper.mjs",
    "manual-nault-operator.mjs",
    "manual-nault-tty.mjs"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 *.test.mjs"
  },
  "openclaw": {
    "extensions": [
      "./index.mjs"
    ]
  },
  "dependencies": {
    "@x402nano/exact": "0.3.0",
    "@x402nano/helper": "0.2.0",
    "typebox": "1.1.38",
    "nano-sdk": "1.0.7"
  },
  "peerDependencies": {
    "openclaw": "2026.5.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carrerasdarren-cell/openclaw-nano-x402-guard.git"
  },
  "homepage": "https://github.com/carrerasdarren-cell/openclaw-nano-x402-guard#readme"
}
